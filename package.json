    "generate:demo": "tsx src/index.ts --demo --username duartess7 --output dist/nightfall-snake.svg"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
