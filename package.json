{
  "name": "nightfall-snake",
  "version": "1.0.0",
  "private": true,
  "description": "Original animated contribution snake for the duartess7 GitHub profile",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
